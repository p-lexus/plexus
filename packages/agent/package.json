{
  "name": "plexus-agent",
  "version": "1.3.0",
  "description": "Join an agent mesh in fifteen lines. A tiny client for the Agent Mesh Protocol over MQTT.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "bin": { "plexus": "./bin/plexus.js" },
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.js" },
    "./plugin": "./plugin.js"
  },
  "files": ["index.js", "index.d.ts", "plugin.js", "bin", "plexus.example.json", "README.md"],
  "engines": { "node": ">=18" },
  "keywords": ["agent", "mesh", "mqtt", "multi-agent", "protocol", "plexus", "ai", "delegation"],
  "license": "Apache-2.0",
  "author": "Mohanad Ghali",
  "repository": { "type": "git", "url": "git+https://github.com/MoGhali/plexus.git", "directory": "packages/agent" },
  "homepage": "https://github.com/MoGhali/plexus#readme",
  "dependencies": {
    "mqtt": "^5.10.1"
  }
}
