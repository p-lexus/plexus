{
  "name": "agent-mesh-bridge",
  "version": "1.0.0",
  "description": "Reference implementation of the Agent Mesh Protocol v1.2 \u2014 an OpenClaw plugin bridging agent job dispatch over MQTT.",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run copy:assets",
    "copy:assets": "rm -rf dist/web && mkdir -p dist/web && cp -R web/. dist/web/ && cp services.example.json dist/ && { cp services.json dist/ 2>/dev/null || true; }",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/render-check.mjs"
  },
  "dependencies": {
    "mqtt": "^5.10.1",
    "typebox": "^1.3.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": "2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1",
      "pluginSdkVersion": "2026.7.1"
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
