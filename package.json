{
  "name": "plexus-bridge",
  "version": "1.0.0",
  "description": "Plexus \u2014 Agent Mesh Protocol v1.3. Autonomous agents dispatching work to each other over MQTT, across laptops, VPNs and containers with no inbound route.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Mohanad Ghali",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoGhali/plexus.git"
  },
  "homepage": "https://github.com/MoGhali/plexus#readme",
  "bugs": {
    "url": "https://github.com/MoGhali/plexus/issues"
  },
  "keywords": [
    "agent",
    "mesh",
    "protocol",
    "mqtt",
    "multi-agent",
    "ai-agents",
    "delegation",
    "openclaw",
    "plexus"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc && npm run copy:assets",
    "copy:assets": "rm -rf dist/web && mkdir -p dist/web && cp -R web/. dist/web/ && cp services.example.json dist/",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/unit.mjs && node test/render-check.mjs && node test/packages.mjs",
    "test:unit": "node test/unit.mjs",
    "test:panel": "node test/render-check.mjs",
    "test:packages": "node test/packages.mjs",
    "demo": "node examples/demo.mjs",
    "pdf": "node tools/pdf.mjs PROTOCOL.md PROTOCOL.pdf",
    "site:video": "node tools/panel-video.mjs"
  },
  "dependencies": {
    "mqtt": "^5.10.1",
    "typebox": "^1.3.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": "2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1",
      "pluginSdkVersion": "2026.7.1"
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
